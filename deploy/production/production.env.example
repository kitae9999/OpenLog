# postgres container
POSTGRES_DB=openlog
POSTGRES_USER=openlog
POSTGRES_PASSWORD=change-me

# backend datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/openlog
SPRING_DATASOURCE_USERNAME=openlog
SPRING_DATASOURCE_PASSWORD=change-me

# redis
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
SPRING_KAFKA_CONSUMER_GROUP_ID=openlog
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
SPRING_KAFKA_CONSUMER_KEY_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
SPRING_KAFKA_CONSUMER_VALUE_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
SPRING_KAFKA_PRODUCER_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
SPRING_KAFKA_PRODUCER_VALUE_SERIALIZER=org.springframework.kafka.support.serializer.JacksonJsonSerializer

# debezium kafka connect
DEBEZIUM_CONNECT_VERSION=3.4
DEBEZIUM_CONNECT_GROUP_ID=openlog-debezium
DEBEZIUM_CONNECT_CONFIG_STORAGE_TOPIC=openlog_connect_configs
DEBEZIUM_CONNECT_OFFSET_STORAGE_TOPIC=openlog_connect_offsets
DEBEZIUM_CONNECT_STATUS_STORAGE_TOPIC=openlog_connect_statuses
DEBEZIUM_CONNECT_HEAP_OPTS=-Xms256M -Xmx512M
DEBEZIUM_CONNECT_LOG_LEVEL=INFO

# debezium postgres connector
DEBEZIUM_CONNECTOR_NAME=openlog-outbox-cdc
DEBEZIUM_DATABASE_HOSTNAME=postgres
DEBEZIUM_DATABASE_PORT=5432
DEBEZIUM_DATABASE_USER=openlog
DEBEZIUM_DATABASE_PASSWORD=change-me
DEBEZIUM_DATABASE_DBNAME=openlog
DEBEZIUM_TOPIC_PREFIX=openlog
DEBEZIUM_SLOT_NAME=openlog_debezium
DEBEZIUM_PUBLICATION_NAME=openlog_publication
DEBEZIUM_SNAPSHOT_MODE=initial
DEBEZIUM_OUTBOX_TABLE_INCLUDE_LIST=public.outbox_events

# flyway
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=20260324

# media storage (use gcs on the current GCP VM and oci after cutover)
MEDIA_STORAGE_PROVIDER=gcs
MEDIA_BUCKET_NAME=openlog_prod
OCI_OBJECT_STORAGE_NAMESPACE=nrmx0ag4fibk
OCI_REGION=ap-tokyo-1

# oauth
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GOOGLE_REDIRECT_URI=https://your-domain/api/auth/google/callback

# jwt
AUTH_JWT_SECRET=change-me
AUTH_JWT_ISSUER=openlog
AUTH_JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
AUTH_JWT_COOKIE_NAME=openlog_access_token
AUTH_JWT_COOKIE_SECURE=true
AUTH_JWT_COOKIE_DOMAIN=.openlog.kr

# app
APP_FRONTEND_HOME_URL=https://your-frontend-domain
SERVER_SERVLET_CONTEXT_PATH=/api
SERVER_FORWARD_HEADERS_STRATEGY=framework
SERVER_PORT=8080
JAVA_OPTS=-Xms256m -Xmx512m

# nginx
NGINX_SERVER_NAME=api.openlog.kr
NGINX_SSL_CERTIFICATE=/etc/nginx/certs/api.openlog.kr.pem
NGINX_SSL_CERTIFICATE_KEY=/etc/nginx/certs/api.openlog.kr.key

# image tag written by CD
BACKEND_IMAGE=ghcr.io/owner/repo/backend:production
