{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "${env:DEBEZIUM_DATABASE_HOSTNAME}",
  "database.port": "${env:DEBEZIUM_DATABASE_PORT}",
  "database.user": "${env:DEBEZIUM_DATABASE_USER}",
  "database.password": "${env:DEBEZIUM_DATABASE_PASSWORD}",
  "database.dbname": "${env:DEBEZIUM_DATABASE_DBNAME}",
  "topic.prefix": "${env:DEBEZIUM_TOPIC_PREFIX}",
  "plugin.name": "pgoutput",
  "slot.name": "${env:DEBEZIUM_SLOT_NAME}",
  "publication.name": "${env:DEBEZIUM_PUBLICATION_NAME}",
  "publication.autocreate.mode": "filtered",
  "schema.include.list": "public",
  "table.include.list": "${env:DEBEZIUM_OUTBOX_TABLE_INCLUDE_LIST}",
  "snapshot.mode": "${env:DEBEZIUM_SNAPSHOT_MODE}",
  "include.schema.changes": "false",
  "tombstones.on.delete": "false",
  "decimal.handling.mode": "string",
  "time.precision.mode": "adaptive_time_microseconds",
  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.table.field.event.id": "id",
  "transforms.outbox.table.field.event.key": "entity_id",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.table.fields.additional.placement": "event_type:header:eventType,event_domain:header:eventDomain,occurred_at:header:occurredAt",
  "transforms.outbox.table.expand.json.payload": "true",
  "transforms.outbox.route.by.field": "event_domain",
  "transforms.outbox.route.topic.replacement": "${routedByValue}-events"
}
